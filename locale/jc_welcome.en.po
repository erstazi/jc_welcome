msgstr "Do NOT ask for others' passwords."

msgid "Each player is responsible for their account security."
msgstr "Each player is responsible for their account security."

msgid "Keep a friendly and safe environment for everyone."
msgstr "Keep a friendly and safe environment for everyone."

msgid "Do NOT post +18 or inappropriate content."
msgstr "Do NOT post +18 or inappropriate content."

msgid "Romantic or inappropriate roleplay is forbidden."
msgstr "Romantic or inappropriate roleplay is forbidden."

