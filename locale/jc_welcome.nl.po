msgstr "Voortgangspaneel beschermer"

msgid "Player"
msgstr "Speler"

msgid "Hours"
msgstr "Uren"

msgid "Activity %"
msgstr "Activiteit %"

msgid "Join Ratio"
msgstr "Deelnameverhouding"

msgid "Days"
